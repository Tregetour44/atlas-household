{"voice": "kokoro-fablemix", "id": "L01", "dur": 2.52, "utmos": 4.413, "f0": 110.0, "f0_st": 6.63, "wer": 0.0, "asr": "Done kitchen lights off", "wps": 2.35, "accent": "us", "eng_us": -0.071, "sim_cbfable": 0.475}
{"voice": "kokoro-fablemix", "id": "L02", "dur": 4.12, "utmos": 4.459, "f0": 105.6, "f0_st": 6.1, "wer": 0.0, "asr": "Would you like the blinds down as well, or shall I leave them?", "wps": 3.96, "accent": "england", "eng_us": 0.1, "sim_cbfable": 0.662}
{"voice": "kokoro-fablemix", "id": "L03", "dur": 7.7, "utmos": 4.518, "f0": 110.0, "f0_st": 4.78, "wer": 0.0, "asr": "It's 23 degrees outside, the battery's at 68%, and the dishwasher finishes at quarter past nine.", "wps": 2.51, "accent": "england", "eng_us": 0.37, "sim_cbfable": 0.803}
{"voice": "kokoro-fablemix", "id": "L04", "dur": 5.47, "utmos": 4.491, "f0": 103.2, "f0_st": 5.71, "wer": 0.0, "asr": "The garage door, I'm told, is beyond my reach, which is probably for the best.", "wps": 3.23, "accent": "australia", "eng_us": 0.225, "sim_cbfable": 0.772}
{"voice": "kokoro-fablemix", "id": "L05", "dur": 5.85, "utmos": 4.482, "f0": 113.2, "f0_st": 5.07, "wer": 0.0, "asr": "Good night. Everything's switched off. The doors are your department and tomorrow looks sunny.", "wps": 2.85, "accent": "england", "eng_us": 0.265, "sim_cbfable": 0.778}
{"voice": "kokoro-fablemix", "id": "L06", "dur": 10.45, "utmos": 4.497, "f0": 106.3, "f0_st": 5.17, "wer": 0.0, "asr": "Solar did rather well today. You made just over 30 kilowatt hours, used about half of it, and sent the rest to the grid while the battery filled up by early afternoon.", "wps": 3.35, "accent": "england", "eng_us": 0.303, "sim_cbfable": 0.829}
{"voice": "kokoro-fablemix", "id": "L07", "dur": 6.35, "utmos": 4.485, "f0": 107.8, "f0_st": 5.27, "wer": 0.0, "asr": "Careful, there's a storm warning from 6 this evening, with gusts up to 90 kilometres an hour.", "wps": 3.07, "accent": "england", "eng_us": 0.331, "sim_cbfable": 0.73}
{"voice": "kokoro-fablemix", "id": "L08", "dur": 4.62, "utmos": 4.447, "f0": 108.1, "f0_st": 4.75, "wer": 0.0, "asr": "I'm sorry I can't do that one yet. Shall I ask Claude instead?", "wps": 3.57, "accent": "us", "eng_us": -0.02, "sim_cbfable": 0.674}
{"voice": "kokoro-fablemix", "id": "L09", "dur": 6.55, "utmos": 4.478, "f0": 111.9, "f0_st": 4.97, "wer": 0.0, "asr": "Rather a gray afternoon, I'm afraid. The forecast can't make up its mind, so I'd take a jacket.", "wps": 3.21, "accent": "england", "eng_us": 0.308, "sim_cbfable": 0.801}
{"voice": "kokoro-fablemix", "id": "L10", "dur": 3.23, "utmos": 4.46, "f0": 106.3, "f0_st": 6.98, "wer": 0.0, "asr": "Good morning coffee weather, I'd say", "wps": 2.52, "accent": "england", "eng_us": 0.446, "sim_cbfable": 0.575}
